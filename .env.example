# ------------------------------------------------------------------
# DocuFlow environment variables (example values only)
# Copy to .env and fill with YOUR values. Never commit the real .env.
# ------------------------------------------------------------------

# Google Cloud Vision / Sheets (service account JSON file path)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# Google Sheets target (only needed when using the Sheets integration)
SHEET_ID=your-spreadsheet-id-here
SHEET_NAME=Principal

# Ollama local OCR endpoint (glm-ocr or any vision model)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=glm-ocr:latest

# LLM corrector model (local, via Ollama or any OpenAI-compatible endpoint)
LLM_CORRECTOR_MODEL=qwen2.5-3b-instruct-q4_k_m.gguf

# Logging
LOG_LEVEL=INFO
