# ============================================================================
# Docker ignore for DocuFlow
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Python artifacts
__pycache__
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info
dist
build
.eggs

# Virtual environments
.venv
venv
env
ENV

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Testing (except fixtures)
.pytest_cache
.coverage
htmlcov
.tox

# Documentation builds
docs/_build
site

# Environment files (keep .env.example)
.env
.env.local
.env.*.local

# Logs
*.log
logs

# Credentials and secrets
credentials
*.key
*.pem
*.p12
auth.json
secrets

# Real data directories (never ship user data in image)
data
models
input
output

# Archives
*.tar.gz
*.zip
*.rar
*.7z

# Local development
*.bak
*.backup
node_modules

# OS
Thumbs.db
.DS_Store

# Keep: tests/fixtures/*.png (synthetic samples for examples)
# Keep: all source code, docs, scripts
